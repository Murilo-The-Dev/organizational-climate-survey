# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=clima_user
DB_PASS=clima_password
DB_NAME=clima_organizacional
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINS=30

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_in_production

# Server
APP_NAME=organizational-climate-survey
APP_PORT=8080
APP_ENV=production

# CORS
FRONTEND_URL=http://localhost:3000

# Request limits
REQUEST_BODY_LIMIT_BYTES=5242880

# Security
HASH_SALT=change_this_hash_salt_for_production

# Logs
LOG_LEVEL=info